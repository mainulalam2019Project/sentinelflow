# PostgreSQL
DATABASE_URL=Host=localhost;Port=5433;Database=sentinelflow;Username=sentinel;Password=sentinel

# JWT
AUTH_SECRET=change-me-to-a-random-32-char-string
Jwt__Key=change-me-in-production-32-chars-minimum!
Jwt__Issuer=sentinelflow
Jwt__Audience=sentinelflow-clients

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
